# Puerto del backend
PORT=3000

# Origen(es) permitidos para el frontend durante desarrollo.
# Si usas Live Server de VS Code:
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Puedes agregar otro origen separándolo con comas:
# FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# URL de la API ASEH
ASEH_TOKEN_URL=https://webapp.aseh.gob.mx/api.nomina.sc/api/auth/token
ASEH_NOMINA_URL=https://webapp.aseh.gob.mx/api.nomina.sc/api/nomina/consulta

# Cambia esto por una cadena larga y aleatoria antes de producción.
SESSION_SECRET=cambia-esta-clave-por-una-muy-larga-y-aleatoria

# En producción HTTPS debe ser true.
COOKIE_SECURE=false
